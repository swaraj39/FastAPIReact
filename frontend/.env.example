# ============================================================
# Frontend environment variables (Vite loads these at build time).
# Copy this file to `.env` and adjust for your environment.
#
# The API base URL is REQUIRED for both dev and production - the Vite
# dev proxy was removed, so the frontend always calls the backend
# directly and relies on the backend CORS settings.
# ============================================================

# Development:
VITE_API_BASE_URL=http://localhost:8000

# Production:
# VITE_API_BASE_URL=https://api.yourdomain.com
