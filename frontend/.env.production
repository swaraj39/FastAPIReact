# ============================================================
# Production build environment variables.
#
# VITE_API_BASE_URL: the full backend URL the browser calls directly.
#   - Vercel + Render (separate platforms): set to your Render service URL.
#   - Docker / VPS (same box): keep "/api" and let nginx proxy.
#
# During Vercel deploy, set VITE_API_BASE_URL in the dashboard
# (Settings → Environment Variables). The value here is a fallback
# for local `npm run build` testing.
# ============================================================
VITE_API_BASE_URL=https://fastapi-jwt-rbac.onrender.com
