APP_NAME=FastAPI JWT RBAC
# --- Cloud DB (Supabase) ---
# Session pooler (port 5432) - used for migrations + the running app.
# Password's "@" is encoded as %40.
DATABASE_URL=postgresql://postgres.nmkhalufticbbtklrqiw:Swaraj%401403@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543) - higher connection limits; use this for the
# deployed API in production later. NOT ideal for running migrations.
# DATABASE_URL=postgresql://postgres.nmkhalufticbbtklrqiw:Swaraj%401403@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Local dev DB (switch back anytime) ---
# DATABASE_URL=postgresql://postgres:Swaraj%4039@localhost:5432/fastapiall
# Random 256-bit key (generated via secrets.token_hex(32)) - NEVER reuse
# the old docs-example key, and never commit a real one.
SECRET_KEY=f90cc6aa687b8f38d5005d580c65c0c771c2e8b2e738f15f84dca466f677d02d
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# NOTE: ENVIRONMENT and REDIS_URL are intentionally NOT set here.
# - Local `uvicorn` runs fall back to config.py defaults (dev + localhost).
# - Docker containers get them from docker-compose.yml (prod + Redis Cloud).
# One .env, two correct contexts.
LOG_DIR=logs
CORS_ORIGINS=http://localhost:5173
